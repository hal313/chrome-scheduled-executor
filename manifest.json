{
  "manifest_version": 3,
  "name": "Scheduled Executor",
  "version": "1.7.1",
  "description": "Runs execution code every minute in pages matching a URL pattern, only between a start and stop time you choose.",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scheduled Executor",
    "default_popup": "src/options.html?popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
